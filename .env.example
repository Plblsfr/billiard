# Nom de domaine servi par Traefik
DOMAIN=billard.plbls.fr

# Image publiée par le workflow de release (remplacer <owner> par votre compte GitHub, en minuscules).
# Le serveur des parties en ligne utilise la même avec le suffixe -relay.
IMAGE=ghcr.io/<owner>/billard-anglais
TAG=latest

# Réglages Traefik existants
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt
